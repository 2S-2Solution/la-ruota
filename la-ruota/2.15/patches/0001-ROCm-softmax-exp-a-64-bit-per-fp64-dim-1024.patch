From 9384b3a56726db96b5b840aee550161eaad1ec67 Mon Sep 17 00:00:00 2001
From: 2 Solution <info@2solution.it>
Date: Sun, 15 Nov 2026 00:01:57 +0100
Subject: [PATCH 1/2] ROCm softmax: exp a 64 bit per fp64 (dim > 1024)

Nel ramo USE_ROCM, SumExpfFloat e SoftMaxForwardWithMulEpilogue usano __expf, l'esponenziale
a 32 bit, anche quando AccumT e' double: per dim > 1024 il softmax fp64 sbaglia di ~2e-6
relativo (la somma resta 1). Con AccumT double si usa std::exp.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 aten/src/ATen/native/cuda/SoftMax.cu | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/aten/src/ATen/native/cuda/SoftMax.cu b/aten/src/ATen/native/cuda/SoftMax.cu
index bd8c8fa..d17fe68 100644
--- a/aten/src/ATen/native/cuda/SoftMax.cu
+++ b/aten/src/ATen/native/cuda/SoftMax.cu
@@ -96,7 +96,12 @@ template<typename T, typename AccumT, typename OutT>
      , sum(sum) {}
 
    __device__ __forceinline__ OutT operator()(T input) const {
-     return static_cast<OutT>(__expf(input - max_input) * sum);
+     // [LA-RUOTA 2.15] __expf e' l'exp a 32 bit: in fp64 sbaglia di ~2e-6 relativo (dim > 1024 su ROCm)
+     if constexpr (std::is_same_v<AccumT, double>) {
+       return static_cast<OutT>(std::exp(input - max_input) * sum);
+     } else {
+       return static_cast<OutT>(__expf(input - max_input) * sum);
+     }
    }
 
    const AccumT max_input;
@@ -428,7 +433,12 @@ struct SumExpfFloat
     : max_k(v) {}
 
   __device__ __forceinline__ AccumT operator()(AccumT sum, T v) const {
-    return sum + __expf(v - max_k);
+    // [LA-RUOTA 2.15] come sopra: in fp64 serve l'exp a 64 bit
+    if constexpr (std::is_same_v<AccumT, double>) {
+      return sum + std::exp(v - max_k);
+    } else {
+      return sum + __expf(v - max_k);
+    }
   }
 
   const AccumT max_k;
